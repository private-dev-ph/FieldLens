      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assets\" (\"id\" TEXT NOT NULL, \"site_id\" TEXT NOT NULL REFERENCES sites (id) ON DELETE CASCADE, \"serial\" TEXT NOT NULL, \"asset_tag\" TEXT NOT NULL, \"qr_value\" TEXT NOT NULL, \"asset_type\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
